<Window
    x:Class="Apollo.Neb.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Apollo.Neb.Desktop"
    Title="Apollo.NEB">
  <Grid x:Name="Root" RequestedTheme="Dark" Background="#0C141A">
    <Grid.Resources>
      <SolidColorBrush x:Key="NebMuted" Color="#ACBFCC" />
      <SolidColorBrush x:Key="NebMint" Color="#91E5C3" />
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#91E5C3" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#A1F0D2" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#79C7AA" />
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#11251E" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#11251E" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#11251E" />
      <Style x:Key="NebCard" TargetType="Border">
        <Setter Property="Background" Value="#142029" />
        <Setter Property="BorderBrush" Value="#2C404D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
      </Style>
      <Style x:Key="NebLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NebMuted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="NebValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </Grid.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,22,24,26" Spacing="14" MaxWidth="1120">
        <Grid ColumnSpacing="12" Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource NebMint}">
              <TextBlock Text="N" FontSize="23" FontWeight="Bold" Foreground="#11251E"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Apollo.NEB" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="Локальный обзор" Style="{StaticResource NebLabel}" />
            </StackPanel>
          </StackPanel>
          <Button x:Name="OpenPanelButton" AutomationProperties.AutomationId="OpenLocalPanel"
                  Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                  Content="Открыть панель" Click="OpenPanel_Click" IsEnabled="False"
                  VerticalAlignment="Center" MinHeight="38" />
        </Grid>

        <TextBlock Text="Сводка локальной панели" FontSize="18" FontWeight="SemiBold" />
        <Border Style="{StaticResource NebCard}" Background="#152923" BorderBrush="#385C51" Padding="19">
          <StackPanel Spacing="5">
            <TextBlock Text="Хешрейт" Foreground="{StaticResource NebMint}" FontWeight="SemiBold" />
            <TextBlock x:Name="RateValue" AutomationProperties.AutomationId="HashrateValue"
                       Text="—" Foreground="#E7FFF5" FontSize="48" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="ConnectionState" AutomationProperties.AutomationId="PanelState"
                       Text="Проверяем локальную панель…" Foreground="#C9E5DA" TextWrapping="Wrap" />
            <TextBlock x:Name="ObservedValue" AutomationProperties.AutomationId="ObservationTime"
                       Style="{StaticResource NebLabel}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource NebCard}">
            <StackPanel Spacing="5">
              <TextBlock Text="Воркеры в работе" Style="{StaticResource NebLabel}" />
              <TextBlock x:Name="WorkerValue" AutomationProperties.AutomationId="WorkerCount"
                         Text="—" Style="{StaticResource NebValue}" />
              <TextBlock x:Name="AttentionValue" Style="{StaticResource NebLabel}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource NebCard}">
            <StackPanel Spacing="5">
              <TextBlock Text="Мощность" Style="{StaticResource NebLabel}" />
              <TextBlock x:Name="WattsValue" AutomationProperties.AutomationId="PowerValue"
                         Text="—" Style="{StaticResource NebValue}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource NebCard}">
            <StackPanel Spacing="5">
              <TextBlock Text="Шары" Style="{StaticResource NebLabel}" />
              <TextBlock x:Name="SharesValue" AutomationProperties.AutomationId="ShareCount"
                         Text="—" Style="{StaticResource NebValue}" />
              <TextBlock Text="Принято / отклонено" Style="{StaticResource NebLabel}" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource NebCard}">
            <StackPanel Spacing="10">
              <TextBlock Text="Температуры" FontSize="17" FontWeight="SemiBold" />
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                  <TextBlock Text="Ядро" Style="{StaticResource NebLabel}" />
                  <TextBlock x:Name="EdgeValue" AutomationProperties.AutomationId="EdgeTemperature"
                             Text="—" Style="{StaticResource NebValue}" FontSize="17" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="Hotspot" Style="{StaticResource NebLabel}" />
                  <TextBlock x:Name="HotValue" AutomationProperties.AutomationId="HotspotTemperature"
                             Text="—" Style="{StaticResource NebValue}" FontSize="17" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock Text="Память" Style="{StaticResource NebLabel}" />
                  <TextBlock x:Name="MemoryValue" AutomationProperties.AutomationId="MemoryTemperature"
                             Text="—" Style="{StaticResource NebValue}" FontSize="17" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource NebCard}">
            <StackPanel Spacing="5">
              <TextBlock Text="DevFee" FontSize="17" FontWeight="SemiBold" />
              <TextBlock x:Name="FeeValue" AutomationProperties.AutomationId="FeeState"
                         Text="—" Style="{StaticResource NebValue}" FontSize="17" />
              <TextBlock x:Name="FeeRate" Style="{StaticResource NebLabel}" />
            </StackPanel>
          </Border>
        </Grid>

        <Expander x:Name="FleetExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  AutomationProperties.AutomationId="FleetEnrollmentSection">
          <Expander.Header>
            <StackPanel Spacing="3">
              <TextBlock Text="Связь с HTTPS-панелью" FontSize="16" FontWeight="SemiBold" />
              <TextBlock x:Name="FleetLinkMessage" Text="Проверяем сохранённую привязку…"
                         AutomationProperties.AutomationId="FleetLinkState" AutomationProperties.LiveSetting="Polite"
                         Style="{StaticResource NebLabel}" />
            </StackPanel>
          </Expander.Header>
          <StackPanel Spacing="10" Margin="0,8,0,0">
            <StackPanel x:Name="FleetSetup" Spacing="9" Visibility="Collapsed">
              <TextBox x:Name="FleetOriginBox" Header="HTTPS-адрес панели" PlaceholderText="https://panel.example"
                       MaxLength="300" AutomationProperties.AutomationId="FleetOrigin" />
              <PasswordBox x:Name="FleetKeyBox" Header="Одноразовый ключ из раздела «Ноды»"
                           PasswordRevealMode="Hidden" MaxLength="49" AutomationProperties.AutomationId="FleetInvite" />
              <CheckBox x:Name="FleetConsent" AutomationProperties.AutomationId="FleetGpuConsent">
                <TextBlock Text="Передавать показания GPU этого ПК" TextWrapping="Wrap" />
              </CheckBox>
              <Button x:Name="FleetPairButton" Content="Привязать ПК" Click="PairFleet_Click"
                      Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="FleetPair" />
            </StackPanel>
            <StackPanel x:Name="FleetConnectInfo" Visibility="Collapsed" Spacing="2">
              <HyperlinkButton x:Name="FleetConnectedOrigin" Padding="0,2"
                               AutomationProperties.AutomationId="FleetPanelLink" Foreground="{StaticResource NebMint}" />
              <TextBlock x:Name="FleetLastSent" Style="{StaticResource NebLabel}"
                         AutomationProperties.AutomationId="FleetLastSent" />
            </StackPanel>
            <StackPanel x:Name="FleetPowerControls" Spacing="5" Visibility="Collapsed">
              <CheckBox x:Name="FleetPowerConsent" AutomationProperties.AutomationId="FleetPowerConsent"
                        Checked="PowerConsent_Changed" Unchecked="PowerConsent_Changed">
                <TextBlock Text="Разрешить менять лимит мощности NVIDIA в этой сессии" TextWrapping="Wrap" />
              </CheckBox>
              <TextBlock x:Name="FleetPowerStatus" Style="{StaticResource NebLabel}"
                         AutomationProperties.AutomationId="FleetPowerStatus" />
              <TextBlock x:Name="FleetPowerOutcome" Style="{StaticResource NebLabel}"
                         AutomationProperties.AutomationId="FleetPowerOutcome" Visibility="Collapsed" />
            </StackPanel>
            <Button x:Name="FleetCheckButton" Content="Проверить связь" Click="CheckFleet_Click"
                    Visibility="Collapsed" AutomationProperties.AutomationId="FleetCheck" />
            <Button x:Name="FleetForgetButton" Content="Удалить ключ на этом ПК" Click="ForgetFleet_Click"
                    Visibility="Collapsed" AutomationProperties.AutomationId="FleetForget" />
            <TextBlock Style="{StaticResource NebLabel}"
                       Text="Показания передаются, пока окно открыто. Для отзыва ключа выберите ноду в разделе «Ноды» панели." />
          </StackPanel>
        </Expander>

        <StackPanel Spacing="8">
          <TextBlock Text="GPU этого ПК" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="LocalGpuState" Text="Читаем локальные датчики NVIDIA…"
                     AutomationProperties.AutomationId="NvidiaLocalState" Style="{StaticResource NebLabel}" />
          <ItemsControl x:Name="LocalGpuCards">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:LocalGpuCard">
                <Border Style="{StaticResource NebCard}" Padding="15" Margin="0,0,0,8">
                  <StackPanel Spacing="9">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="NvidiaGpuName" />
                      <TextBlock Text="{x:Bind Pci}" Style="{StaticResource NebLabel}"
                                 AutomationProperties.AutomationId="NvidiaGpuPci" />
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Spacing="3">
                        <TextBlock Text="Температура" Style="{StaticResource NebLabel}" />
                        <TextBlock Text="{x:Bind Temperature, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="NvidiaGpuTemperature" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="Загрузка" Style="{StaticResource NebLabel}" />
                        <TextBlock Text="{x:Bind Utilization, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="NvidiaGpuUtilization" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Text="VRAM" Style="{StaticResource NebLabel}" />
                        <TextBlock Text="{x:Bind Memory, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="NvidiaGpuMemory" />
                      </StackPanel>
                      <StackPanel Grid.Column="3" Spacing="3">
                        <TextBlock Text="Потребление" Style="{StaticResource NebLabel}" />
                        <TextBlock Text="{x:Bind Watts, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="NvidiaGpuPower" />
                      </StackPanel>
                    </Grid>
                    <Border Background="#101B22" BorderBrush="#2C404D" BorderThickness="1"
                            CornerRadius="9" Padding="11" Margin="0,3,0,0">
                      <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Spacing="3">
                            <TextBlock Text="Лимит мощности" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Лимит действует на всю видеокарту." Style="{StaticResource NebLabel}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="Текущий" Style="{StaticResource NebLabel}" TextAlignment="Right" />
                            <TextBlock Text="{x:Bind CurrentLimit, Mode=OneWay}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource NebMint}" TextAlignment="Right"
                                       AutomationProperties.AutomationId="NvidiaGpuCurrentLimit" />
                          </StackPanel>
                        </Grid>

                        <StackPanel Spacing="6" Visibility="{x:Bind PickerVisibility, Mode=OneWay}">
                          <ComboBox Header="Профиль" ItemsSource="{x:Bind Presets, Mode=OneWay}"
                                    SelectedItem="{x:Bind SelectedPreset, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch" MaxWidth="400"
                                    Visibility="{x:Bind PresetsVisibility, Mode=OneWay}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                    AutomationProperties.AutomationId="NvidiaGpuPowerProfile">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="local:LocalPowerPreset">
                                <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Выбранный лимит, Вт" HorizontalAlignment="Left" MinWidth="104"
                                     PlaceholderText="Вт" MaxLength="4" InputScope="Number"
                                     IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                     Text="{x:Bind WattInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="NvidiaGpuPowerWatts" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}"
                                    Content="{x:Bind ApplyText, Mode=OneWay}" IsEnabled="{x:Bind CanApply, Mode=OneWay}"
                                    Click="ApplyLocalPower_Click" AutomationProperties.AutomationId="ApplyLocalNvidiaPower" />
                          </Grid>
                          <TextBlock Text="{x:Bind RangeText, Mode=OneWay}" Style="{StaticResource NebLabel}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Help, Mode=OneWay}" Style="{StaticResource NebLabel}"
                                   AutomationProperties.AutomationId="NvidiaGpuLocalPowerHelp" />
                        <TextBlock Text="{x:Bind Outcome, Mode=OneWay}" Style="{StaticResource NebLabel}"
                                   Visibility="{x:Bind OutcomeVisibility, Mode=OneWay}"
                                   AutomationProperties.AutomationId="NvidiaGpuLocalPowerOutcome"
                                   AutomationProperties.LiveSetting="Polite" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Style="{StaticResource NebCard}">
          <StackPanel Spacing="10">
            <TextBlock Text="Локальное подключение" FontSize="17" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="PortBox" AutomationProperties.AutomationId="LoopbackPort"
                       Header="Порт" Width="100" MaxLength="5" />
              <Button x:Name="RefreshButton" AutomationProperties.AutomationId="ReadSnapshot"
                      Content="Обновить" Click="Refresh_Click" VerticalAlignment="Bottom" MinHeight="32" />
            </StackPanel>
            <TextBlock x:Name="EndpointValue" Style="{StaticResource NebLabel}" />
            <TextBlock x:Name="PortError" Foreground="#FFC0B7" TextWrapping="Wrap" Visibility="Collapsed" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
